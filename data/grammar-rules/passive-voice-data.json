{
  "title": "Passive Voice",
  "level": "B2 First",
  "version": "3.0",
  "note": "One file for the whole topic: the rules page, the practice page and the quiz all read this. Cues live in `highlightVerb` and, for the passive, the cue is the time adverbial that forces the tense — REPORTING items have no cue because their trigger (the reporting verb) is not in the sentence, so those keep a `helper` chip instead.",
  "rules": [
    {
      "id": "basic",
      "title": "BASIC",
      "subtitle": "The house was painted",
      "icon": "🏠",
      "mainTitle": "Simple Passive Voice",
      "explanation": "Use passive voice when the action is more important than who does it, or when the doer is unknown or obvious. The focus shifts from WHO does the action to WHAT happens.",
      "structure": "be + past participle",
      "sets": [
        {
          "setTitle": "Set 1: Simple Tenses (Present, Past, Future)",
          "examples": [
            {
              "before": "The architect <<designs>> modern buildings.",
              "after": "Modern buildings **<<are designed>>** by the architect."
            },
            {
              "before": "Mrs. Jenkins <<designed>> our new flat.",
              "after": "Our new flat **<<was designed>>** by Mrs. Jenkins."
            },
            {
              "before": "They <<will announce>> the results tomorrow.",
              "after": "The results **<<will be announced>>** tomorrow."
            },
            {
              "before": "Someone <<has stolen>> my bicycle.",
              "after": "My bicycle **<<has been stolen>>**."
            },
            {
              "before": "They <<are building>> a new bridge.",
              "after": "A new bridge **<<is being built>>**."
            }
          ]
        },
        {
          "setTitle": "Set 2: Modals (can, could, should, must, may, might)",
          "examples": [
            {
              "before": "They <<should repair>> the roof immediately.",
              "after": "The roof **<<should be repaired>>** immediately."
            },
            {
              "before": "Someone <<must clean>> these windows.",
              "after": "These windows **<<must be cleaned>>**."
            },
            {
              "before": "Mrs. Jenkins <<might design>> our new flat.",
              "after": "Our new flat **<<might be designed>>** by Mrs. Jenkins."
            },
            {
              "before": "They <<could finish>> the project next week.",
              "after": "The project **<<could be finished>>** next week."
            },
            {
              "before": "Someone <<may deliver>> the package today.",
              "after": "The package **<<may be delivered>>** today."
            }
          ]
        },
        {
          "setTitle": "Set 3: Perfect Modals & Past Continuous",
          "examples": [
            {
              "before": "Someone <<might have stolen>> the painting.",
              "after": "The painting **<<might have been stolen>>**."
            },
            {
              "before": "They <<should have informed>> us earlier.",
              "after": "We **<<should have been informed>>** earlier."
            },
            {
              "before": "The house agent <<might have put>> the house on the market.",
              "after": "The house **<<might have been put>>** on the market."
            },
            {
              "before": "Someone <<was repairing>> the computer when I arrived.",
              "after": "The computer **<<was being repaired>>** when I arrived."
            },
            {
              "before": "They <<must have finished>> the work by now.",
              "after": "The work **<<must have been finished>>** by now."
            }
          ]
        }
      ]
    },
    {
      "id": "causative",
      "title": "CAUSATIVE",
      "subtitle": "We had our house painted",
      "icon": "🔧",
      "mainTitle": "Having Something Done (Services)",
      "explanation": "Use this structure when someone else does something for you (you arrange or pay for a service). You don't do it yourself - someone does it FOR you.",
      "structure": "have/get + object + past participle",
      "sets": [
        {
          "setTitle": "Set 1: Present & Past (have/had)",
          "examples": [
            {
              "before": "The mechanic <<services>> my car every year.",
              "after": "I **<<have>> my car <<serviced>>** every year."
            },
            {
              "before": "The hairdresser <<cut>> my hair yesterday.",
              "after": "I **<<had>> my hair <<cut>>** yesterday."
            },
            {
              "before": "A decorator <<is painting>> our living room.",
              "after": "We **<<are having>> our living room <<painted>>**."
            },
            {
              "before": "The dentist <<removed>> my wisdom tooth last week.",
              "after": "I **<<had>> my wisdom tooth <<removed>>** last week."
            },
            {
              "before": "A technician <<will install>> the new system tomorrow.",
              "after": "We **<<will have>> the new system <<installed>>** tomorrow."
            }
          ]
        },
        {
          "setTitle": "Set 2: get (more informal) & Modals",
          "examples": [
            {
              "before": "The optician <<should test>> your eyes regularly.",
              "after": "You **<<should get>> your eyes <<tested>>** regularly."
            },
            {
              "before": "Mrs. Jenkins <<might design>> our new flat.",
              "after": "We **<<might get>> our new flat <<designed>>** by Mrs. Jenkins."
            },
            {
              "before": "A plumber <<is going to fix>> our heating system.",
              "after": "We **<<are getting>> our heating system <<fixed>>**."
            },
            {
              "before": "The garage <<must check>> your brakes.",
              "after": "You **<<must get>> your brakes <<checked>>**."
            },
            {
              "before": "A professional photographer <<could take>> our wedding photos.",
              "after": "We **<<could get>> our wedding photos <<taken>>** by a professional."
            }
          ]
        },
        {
          "setTitle": "Set 3: Perfect Forms & Modals with have",
          "examples": [
            {
              "before": "The builders <<have renovated>> our kitchen.",
              "after": "We **<<have had>> our kitchen <<renovated>>**."
            },
            {
              "before": "Someone <<might redecorate>> our house next year.",
              "after": "We **<<might get>> our house <<redecorated>>** next year."
            },
            {
              "before": "The tailor <<should have altered>> your suit by now.",
              "after": "You **<<should have had>> your suit <<altered>>** by now."
            },
            {
              "before": "Someone <<had already repaired>> the roof when we moved in.",
              "after": "We **<<had had>> the roof <<repaired>>** before we moved in."
            },
            {
              "before": "A specialist <<must examine>> your documents carefully.",
              "after": "You **<<must have>> your documents <<examined>>** carefully."
            }
          ]
        }
      ]
    },
    {
      "id": "reporting",
      "title": "REPORTING",
      "subtitle": "She is known to be talented",
      "icon": "📰",
      "mainTitle": "Reporting What People Say, Think, or Believe",
      "explanation": "Use reporting structures to express what people say, think, or believe - especially in formal contexts like news reports. These structures make statements sound more objective and less direct.",
      "structure": "is said/known/believed/thought/claimed/reported + to + infinitive",
      "sets": [
        {
          "setTitle": "Set 1: Same Time (to be / to be + -ing)",
          "examples": [
            {
              "before": "People <<say>> that Mrs. Jenkins is very talented.",
              "after": "Mrs. Jenkins **<<is said to be>>** very talented."
            },
            {
              "before": "Everyone <<knows>> that the director is honest.",
              "after": "The director **<<is known to be>>** honest."
            },
            {
              "before": "People <<think>> that Mrs. Jenkins <<is designing>> the new cathedral.",
              "after": "Mrs. Jenkins **<<is thought to be designing>>** the new cathedral."
            },
            {
              "before": "They <<believe>> that the company is expanding rapidly.",
              "after": "The company **<<is believed to be expanding>>** rapidly."
            },
            {
              "before": "People <<claim>> that the politician is lying.",
              "after": "The politician **<<is claimed to be lying>>**."
            }
          ]
        },
        {
          "setTitle": "Set 2: Past Actions (to have + past participle)",
          "examples": [
            {
              "before": "People <<believe>> that the prisoner <<escaped>> through a tunnel.",
              "after": "The prisoner **<<is believed to have escaped>>** through a tunnel."
            },
            {
              "before": "Everyone <<thinks>> that the athlete <<broke>> the world record.",
              "after": "The athlete **<<is thought to have broken>>** the world record."
            },
            {
              "before": "They <<say>> that Mrs. Jenkins <<designed>> the cathedral.",
              "after": "Mrs. Jenkins **<<is said to have designed>>** the cathedral."
            },
            {
              "before": "People <<claim>> that the minister <<accepted>> bribes.",
              "after": "The minister **<<is claimed to have accepted>>** bribes."
            },
            {
              "before": "They <<report>> that the actor <<has left>> the country.",
              "after": "The actor **<<is reported to have left>>** the country."
            }
          ]
        },
        {
          "setTitle": "Set 3: Mixed Verbs & Past States (to have been)",
          "examples": [
            {
              "before": "People <<allege>> that the company <<was involved>> in fraud.",
              "after": "The company **<<is alleged to have been>>** involved in fraud."
            },
            {
              "before": "Everyone <<expects>> that the team <<will win>> the championship.",
              "after": "The team **<<is expected to win>>** the championship."
            },
            {
              "before": "They <<consider>> that the artist is a genius.",
              "after": "The artist **<<is considered to be>>** a genius."
            },
            {
              "before": "People <<understand>> that the situation <<was>> very difficult.",
              "after": "The situation **<<is understood to have been>>** very difficult."
            },
            {
              "before": "They <<suppose>> that Mrs. Jenkins <<has finished>> the designs.",
              "after": "Mrs. Jenkins **<<is supposed to have finished>>** the designs."
            }
          ]
        }
      ]
    }
  ],
