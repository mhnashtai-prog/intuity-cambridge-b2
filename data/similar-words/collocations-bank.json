 "meta": {
  "schema": "collocations-v1",
  "note": "NODE is the unit and the browsing axis. The previous file was organised by the ADVERB'S function class — maximizers, boosters, moderators — which is a linguist's axis: a learner never arrives asking what a booster is, they arrive holding a word and needing its partner. Which adverb goes with COLD. That question could not be asked of the old file at all.",
  "patternNote": "Seven patterns, where the old file had one and a half. verb+noun is the largest family and the one B2 Use of English tests most — make/do/take/have carry hundreds of fixed partners and almost none are guessable. noun+verb is newspaper English (prices soar, talks collapse, tension mounts) and is close to absent from coursebooks.",
  "avoidNote": "`avoid` is the field the old file had no room for, and it teaches more than the collocates do. A learner needs to know that 'utterly cold' is WRONG and 'very cold' merely WEAK — two different failures needing two different corrections. Every entry says why, because a rule a student can state is a rule they keep.",
  "strengthNote": "`strong` means the partner most native writers reach for first; `medium` means correct and current but one of several. It is a judgement, not a corpus frequency — it is here so a card can order its collocates rather than list them alphabetically, and it should be checked against a corpus before it is trusted.",
  "provenance": "SEED SET, drafted rather than harvested. The pairs are standard and the avoid notes are the ones learners actually need, but nothing here has been checked against a frequency list. Treat it as a structure with plausible content, to be corrected and extended — not as data.",
  "counts": {
   "nodes": 70,
   "collocates": 213,
   "avoid": 28,
   "patterns": 7
  }
 },
 "patterns": {
  "adv_adj": {
   "label": "Adverb + adjective",
   "frame": "{c} {n}",
   "note": "The intensifier problem. Learners reach for 'very' because it is safe, and safe is the register that costs marks."
  },
  "adv_verb": {
   "label": "Adverb + verb",
   "frame": "{c} {n}",
   "note": "Newspaper register lives here — categorically denied, sharply criticised, strongly advised."
  },
  "verb_noun": {
   "label": "Verb + noun",
   "frame": "{c} {n}",
   "note": "The largest family and the one B2 Use of English tests most. make/do/take/have carry hundreds of fixed partners and almost none are guessable."
  },
  "adj_noun": {
   "label": "Adjective + noun",
   "frame": "{c} {n}",
   "note": "Where the adjective is not the obvious one: heavy rain, strong accent, stark contrast."
  },
  "noun_verb": {
   "label": "Noun + verb",
   "frame": "{n} {c}",
   "note": "What a thing DOES. Headline English: prices soar, tension mounts, talks collapse. Almost absent from coursebooks."
  },
  "noun_noun": {
   "label": "Noun + of + noun",
   "frame": "{c} of {n}",
   "note": "Quantifying and framing: a body of evidence, a wave of protest, a glimmer of hope."
  },
  "verb_prep": {
   "label": "Verb + preposition",
   "frame": "{n} {c}",
   "note": "Not a collocation in the strict sense but the same learning problem: the partner is fixed and unguessable."
  }
 },
