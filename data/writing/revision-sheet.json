{
 "schema": "revision-sheet/1",
 "note": "The Writing revision sheets (Oct 2026). Built for how students actually use the page: copy the frames, learn them, reproduce them in the exam. So every bold line (go:true) must be safe to reproduce in ANY question of that task: correct, semi-formal, and with a slot that forces the question's own content in. One frame per task, 2-3 lines per band. Slots in square brackets are filled from today's question where the data allows: [topic], [note 1], [note 2], [your idea] for essays; [opening], [must 1], [must 2] for stories. 'h' is the tail - what must follow the frame - in five plain words only: + a sentence, + a thing, + verb, + past simple, + your answer. 'covers' maps a band to the question's key points (0-based). 'route' limits a step to one of the task's routes. DRAFT WORDING - Michael to reword where it does not sound like the classroom. cue-generator.json is untouched (cue-cards.html still reads it).",
 "hints": [
  [
   "+ a sentence",
   "a full sentence: someone + does something",
   "…young people learn to share."
  ],
  [
   "+ a thing",
   "a noun, or -ing",
   "…the price. / …playing in a team."
  ],
  [
   "+ verb",
   "a verb, no -ing, no to",
   "…offer more choices."
  ],
  [
   "+ past simple",
   "a finished action",
   "…heard a strange noise."
  ],
  [
   "+ your answer",
   "your opinion, as a sentence",
   "…sport should be compulsory."
  ],
  [
   "+ past continuous",
   "background: was / were + -ing",
   "…the rain was falling."
  ]
 ],
 "moves": [
  {
   "move": "Give a reason",
   "items": [
    {
     "t": "This is because",
     "h": "+ a sentence",
     "go": true
    },
