{
 "meta": {
  "schema": "wordformation-v2",
  "title": "Word formation",
  "audience": "Learners aged 13-15",
  "level": "B2-C1",
  "version": "2.0",
  "provenance": "Seed set, drafted rather than harvested. Pairs, spelling rules and sentences are standard but not checked against a frequency list. Review before classroom use.",
  "fields": {
   "node": "base, pos, level (B2|C1), topic, forms[], avoid[], note?",
   "form": "w, cls, type (prefix|suffix), affix, strength (strong|medium), gloss, ex, teen?, rule?, alts? (exactly 3 wrong affixes => affix-only question), altwhy?{affix:reason}",
   "avoid": "w (common wrong spelling), for (the correct form), why",
   "rules": "id, title, text",
   "affixes": "meaning, tip"
  }
 },
 "rules": [
  {
   "id": "drop-e",
   "title": "Drop the e",
   "text": "A silent e disappears before an ending that starts with a vowel: create + ive = creative."
  },
  {
   "id": "keep-e",
   "title": "Keep the e",
   "text": "Keep the e after c or g so the sound stays soft: courage + ous = courageous."
  },
  {
   "id": "y-to-i",
   "title": "y becomes i",
   "text": "After a consonant, y changes to i before most endings: happy + ness = happiness, rely + able = reliable."
  },
  {
   "id": "double",
   "title": "Double the letter",
   "text": "Some words double the last letter before an ending: sun + y = sunny. After a prefix, both letters stay: mis + spell = misspell."
  },
  {
   "id": "stem-change",
   "title": "The stem changes",
   "text": "Some words change inside before the ending. Learn the pair, not the rule: decide, decision. strong, strength."
  },
  {
   "id": "assimilation",
   "title": "in- changes shape",
   "text": "in- becomes im- before p or m, il- before l and ir- before r."
  },
  {
   "id": "keep-both",
   "title": "Keep every letter",
   "text": "A prefix or ending never removes a letter from the base: dis + satisfied, embarrass + ment."
  }
 ],
 "affixes": {
  "un-": {
   "meaning": "not, the opposite",
   "tip": "The most common negative prefix. Use it with many adjectives and with verbs that reverse an action."
  },
  "in-": {
   "meaning": "not",
   "tip": "Often used with Latin-style words: inaccurate, incomplete. Changes to im-, il-, ir-."
  },
  "im-": {
   "meaning": "not",
   "tip": "in- before p or m: impatient, immature."
  },
  "il-": {
   "meaning": "not",
   "tip": "in- before l: illegal, illogical."
  },
  "ir-": {
   "meaning": "not",
   "tip": "in- before r: irregular, irresponsible."
  },
  "dis-": {
   "meaning": "not, the opposite, apart",
   "tip": "Used with verbs and nouns: disagree, dishonest, disconnect."
  },
  "mis-": {
   "meaning": "wrongly, badly",
   "tip": "Something done in the wrong way: misunderstand, mislead."
  },
  "re-": {
   "meaning": "again",
   "tip": "Do something a second time: rebuild, rewrite."
  },
  "over-": {
   "meaning": "too much",
   "tip": "overestimate, overreact. The opposite is under-."
  },
  "under-": {
   "meaning": "too little",
   "tip": "underestimate, underpay."
  },
  "en-": {
   "meaning": "cause to be, put into",
   "tip": "Makes verbs: enable, enlarge, encourage."
  },
  "-ion": {
   "meaning": "the act or result of",
   "tip": "Makes nouns from verbs. The stem often changes: decide, decision."
  },
  "-ation": {
   "meaning": "the act or result of",
   "tip": "Makes nouns from verbs ending in -ate, -ise, or -ify: organise, organisation."
  },
  "-ition": {
   "meaning": "the act or result of",
   "tip": "Makes nouns from verbs like compete: competition."
  },
  "-ive": {
   "meaning": "having the quality of",
   "tip": "Makes adjectives from verbs: attractive, creative."
  },
  "-ful": {
   "meaning": "full of",
   "tip": "Only one l. Careful, useful, successful."
  },
  "-less": {
   "meaning": "without",
   "tip": "The opposite of -ful: careless, useless."
  },
  "-able": {
   "meaning": "can be done",
   "tip": "More common than -ible. Use it with whole base words: enjoyable, reliable."
  },
  "-ible": {
   "meaning": "can be done",
   "tip": "Sounds the same as -able. Only the spelling tells you: accessible, visible."
  },
  "-ous": {
   "meaning": "full of, having",
   "tip": "Makes adjectives: dangerous, nervous, jealous."
  },
  "-eous": {
   "meaning": "full of, having",
   "tip": "Keeps the e after g to keep the soft sound: courageous, outrageous."
  },
  "-ious": {
   "meaning": "full of, having",
   "tip": "Often after the letters c, t or x: cautious, suspicious."
  },
  "-ment": {
   "meaning": "the result of an action",
   "tip": "Makes nouns from verbs. Keep the base letters: improvement, embarrassment."
  },
  "-ness": {
   "meaning": "the state of being",
   "tip": "Makes nouns from adjectives: happiness, kindness."
  },
  "-ity": {
   "meaning": "the state or quality of",
   "tip": "Makes nouns from adjectives: popularity, creativity."
  },
  "-ance": {
   "meaning": "the state of, the act of",
   "tip": "Sounds the same as -ence, so learn each noun: importance, appearance."
  },
  "-ence": {
   "meaning": "the state of, the act of",
   "tip": "Often follows -ent adjectives: confident, confidence."
  },
  "-ant": {
   "meaning": "a person or thing that, having the quality of",
   "tip": "tolerant, pollutant."
  },
  "-ent": {
   "meaning": "having the quality of",
   "tip": "Adjectives: different, dependent, confident."
  },
  "-al": {
   "meaning": "to do with",
   "tip": "Makes adjectives from nouns: environmental, national."
  },
  "-ial": {
   "meaning": "to do with",
   "tip": "influential, financial."
  },
  "-ical": {
   "meaning": "to do with",
   "tip": "Sometimes has a different meaning from -ic: economic and economical."
  },
  "-ic": {
   "meaning": "to do with",
   "tip": "historic, economic, artistic."
  },
  "-ly": {
   "meaning": "in this way",
   "tip": "Makes adverbs. Watch the spelling: happily, truly, gently."
  },
  "-ally": {
   "meaning": "in this way",
   "tip": "After adjectives ending in -ic: basically."
  },
  "-ify": {
   "meaning": "make, become",
   "tip": "Makes verbs: simplify, clarify, justify."
  },
  "-ise": {
   "meaning": "make, become",
   "tip": "Makes verbs. British spelling; -ize is American."
  },
  "-en": {
   "meaning": "make, become",
   "tip": "Makes verbs from adjectives: widen, strengthen."
  },
  "-th": {
   "meaning": "the state of",
   "tip": "Makes nouns, with a vowel change: long, length. deep, depth."
  },
  "-ist": {
   "meaning": "a person who does or studies",
   "tip": "scientist, artist, environmentalist."
  },
  "-er": {
   "meaning": "a person who does something",
   "tip": "employer, influencer."
  },
  "-or": {
   "meaning": "a person who does something",
   "tip": "visitor, competitor."
  },
  "-y": {
   "meaning": "state, quality",
   "tip": "Makes nouns (jealousy, honesty) and adjectives (sunny)."
  },
  "-acy": {
   "meaning": "the state of",
   "tip": "privacy, democracy."
  },
  "-ety": {
   "meaning": "the state of",
   "tip": "anxiety, society."
  },
  "-ing": {
   "meaning": "causing a feeling, or happening now",
   "tip": "Makes adjectives from verbs: confusing, embarrassing. Compare -ed: embarrassed means how you feel."
  }
 },
