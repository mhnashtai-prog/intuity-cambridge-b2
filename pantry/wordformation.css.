/* ═══════════════════════════════════════════════════════════════════════
   INTUITY — WORD FORMATION
   Loaded AFTER intuity-shell.css, vocab.css and colloc.css. colloc.css
   already supplies the bank card, the kicker, the partner rows, the avoid
   rows, the practice stem, the pills and the why-note. This file adds only
   what a word-formation card needs on top of that:

     · an affix tag under each form (-ive · adj)
     · the Prefixes / Suffixes toggle under the set row
     · a note line for the cards that carry one (economic / economical)
   ═══════════════════════════════════════════════════════════════════════ */

/* The form and its affix share the first column. The underline that marks a
   strong form belongs to the word alone, so the tag sits beneath it rather
   than inside the .w that carries the box-shadow. */
.wc{display:flex;flex-direction:column;gap:.2rem;align-items:flex-start}
.aff{font-family:var(--f-mono);font-size:.56rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--poster-faint);font-weight:500}

/* A line of teaching that belongs to the whole card, not to one form:
   economic vs economical, -ly after a noun. Same caramel rule the why-note
   uses, but always visible, because it is not a verdict on an answer. */
.wf-note{margin-top:.9rem;padding:.1rem 0 .1rem .8rem;
  border-left:2px solid var(--caramel);font-size:.86rem;line-height:1.55;
  color:var(--poster-body)}

/* The toggle is a view switch, so it takes the shell's .seg (the one filled
   control). It only needs centring and a little air under the set tabs. */
.affix-toggle{display:flex;justify-content:center;margin:.15rem 0 .05rem}

/* Phones: the aff tag drops back under the word already (one column), so
   nothing to change there; just keep the note readable. */
@media (max-width:640px){
  .wf-note{font-size:.84rem}
}

/* AFFIX-ONLY practice: the gap holds a prefix or an ending, so it is narrow,
   and the base word next to it is set in full ink so the eye lands on the
   piece that is missing. */
.q .gap.affix{min-width:2.6em;text-align:center}
.q .stem b{font-weight:700;color:var(--poster-ink)}

/* ── CONTRAST, LOCAL TO THIS PAGE ────────────────────────────────────────
   This stylesheet loads only here, so overriding the shared token here
   leaves every other page on --poster-faint at .50. At .50 the kicker and
   the affix tags measure about 3.4:1 on the paper at 9px, which is too
   faint to read comfortably; .64 gives about 5.4:1 with the same quiet look.
   The labels also grow from .56rem to .64rem. Nothing is added to the
   screen: the same marks, simply legible. */
:root{--poster-faint:rgba(20,17,14,.64)}
.kick,.aff,.avoid-label{font-size:.64rem}

/* The empty gap was a pale bar. A quiet underline says "fill this in" the
   way a blank on paper does; once marked, colloc.css's .q.done rules
   replace it with the caramel mark or the strike-through. */
.q .gap{min-width:3.4em;box-shadow:inset 0 -2px 0 rgba(20,17,14,.42)}
.q .gap.affix{min-width:2.8em}
